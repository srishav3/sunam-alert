# Admin Credentials (Set strong password!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!Secure

# Supabase Database (Get from supabase.com dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Server Configuration
PORT=3000
NODE_ENV=production

# ⚠️ IMPORTANT SECURITY NOTES:
# 1. Keep .env SECRET - never commit to GitHub
# 2. Use strong passwords (12+ chars, mix upper/lower/numbers/symbols)
# 3. SUPABASE_KEY is sensitive - treat like a password
# 4. On production (Render), set these via environment variables dashboard
# 5. Copy this file to .env and fill in your real values
